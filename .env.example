# ============================================================
# sol-grid-bot — configuration reference (safe to commit)
# Copy to .env (git-ignored, contains your real keys) and adjust.
# ============================================================

# --- Mode ---
# paper = simulated fills only (REQUIRED until you explicitly go live)
# live  = real Jupiter swaps on your wallet (never set unless ready)
TRADE_MODE=paper

# --- RPC (Solana) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Jupiter Swap API V2 (legacy quote-api/lite-api URLs auto-upgrade)
JUPITER_API_URL=https://api.jup.ag/swap/v2

# --- On-chain data: REAL meme price history ---
# BirdEye supplies real on-chain OHLCV -> real VWAP for meme tokens (CYB).
# Free key from pro.birdeye.so. The ONLY key needed for meme data.
BIRDEYE_API_KEY=your_birdeye_key

# --- Polling / dashboard ---
POLL_INTERVAL_MS=30000
REFRESH_INTERVAL_MS=5000
PORT=3000

# --- SOL grid history pool (GeckoTerminal SOL/USDC, optional) ---
#GEOKT_POOL=58oQChx4yWmvKdwLLZzBi4ChoCc2fqCUWBkwMihLYQo2

# --- Grid (SOL/USDC) ---
GRID_ENABLED=true
GRID_LOWER=120
GRID_UPPER=180
GRID_LEVELS=8
GRID_USDC_PER_LEVEL=20
GRID_REANCHOR_MIN=240
GRID_DEADZONE_STEPS=2
GRID_COMPOUND_PCT=0
GRID_VOL_SIZING=true
GRID_VWAP_SKEW=true
GRID_SKEW_STRENGTH=0.35
GRID_HISTORY_HOURS=48

# --- DCA (SOL/USDC) ---
DCA_ENABLED=true
DCA_INTERVAL_MIN=120
DCA_USDC_PER_BUY=25
DCA_DIP_PCT=3
DCA_TP_PCT=1.0
DCA_TP_SLICE_PCT=50
DCA_TRAILING_PCT=4
DCA_VA_ENABLED=true
DCA_VA_TARGET_SOL=5
DCA_VA_HORIZON_BUYS=12
# Fee-aware minimum buy notional (USD). A DCA buy pays a near-constant
# network/priority fee per swap, so a micro-buy (e.g. a tiny value-average
# increment) spends more on fees than it banks. Never fire a buy below this.
DCA_MIN_BUY_USD=15

# --- Meme slot: CYB (graduated pump.fun token, thin liquidity) ---
CYB_ENABLED=true
CYB_MAX_USDC=200
CYB_SLIPPAGE_BPS=500
CYB_USDC_PER_BUY=10
CYB_MIN_INTERVAL_MIN=5
CYB_TARGET_DEPOSIT_PCT=0.6
CYB_HISTORY_HOURS=72
CYB_MIN_VOL_USD=100
CYB_MIN_LIQ_USD=1000
# Ring-fenced per-slot loss ceiling: halt CYB accumulation once realized loss
# breaches -CYB_MAX_LOSS_USD (trailing TP still unwinds remaining size).
CYB_MAX_LOSS_USD=60
# Dead-book / exit-liquidity exit: defensively sell out if real pool liquidity
# decays below (peak * (1 - CYB_LIQ_DECAY_EXIT_PCT)) since we started holding.
# 0 = disabled.
CYB_LIQ_DECAY_EXIT_PCT=0.5

# --- Risk ---
RISK_MAX_USDC=400
RISK_HARD_STOP_PCT=0.25
RISK_SLIPPAGE_BPS=100
RISK_MAX_STALE_POLLS=5
# Unrealized draw-down guard: pause NEW deployment if the open SOL basket is
# underwater by more than this fraction of RISK_MAX_USDC. Independent of the
# realized hard-stop; sell/TP legs stay active. 0 = disabled.
RISK_UNREALIZED_STOP_PCT=0.20
# Auto circuit-breaker: if ALL real price feeds go stale for maxStalePolls in
# live mode, auto-arm the kill-switch (halts the swap path). 1 = on, 0 = off.
RISK_AUTO_CIRCUIT_BREAKER=true

# Sanity gate: reject a single-poll price print more than this fraction away from the
# previous price. Stops a glitched quote (e.g. ~$5.97 on real ~$107 SOL) from
# triggering crossed-fill sells / a DCA trailing sell at a fabricated price.
RISK_MAX_SINGLE_JUMP_PCT=0.05
# Min consecutive polls the drifted price must persist before the grid
# re-anchors a drifted band (confirms a real move vs. a single glitchy print).
GRID_REANCHOR_CONFIRM_POLLS=3

# --- Notifications (optional) ---
# Events are ALWAYS logged to .botstate/events.log; set these to also get them
# pushed to Telegram. No secrets are logged.
#TELEGRAM_BOT_TOKEN=123456:ABC
#TELEGRAM_CHAT_ID=your_chat_id

# --- Crash recovery (optional, on by default) ---
# Persist runtime state (positions/orders/trades/trailing signals) to
# .botstate/state-<mode>.json every 30s + on shutdown, then reconcile on
# restart. Live balances are always re-read from chain (never stale).
STATE_PERSIST=true

# --- Native-SOL fee floor (added) ---
# Refuse any live send if the wallet holds less than this much native SOL
# (network/priority fees + sell inventory). Clamped 0.001-1 SOL.
WALLET_FEE_FLOOR_SOL=0.05
# Native SOL the bot ALWAYS keeps for network fees and never sells below. Prevents
# the grid/DCA from selling the fee buffer down to zero and leaving the wallet
# unable to pay for its own trades. Keep at/above the fee floor; the bot
# self-funds its own fees and never needs a manual top-up.
SOL_FEE_RESERVE_SOL=1.0

# --- Wallet / sizing (LIVE MODE ONLY) ---
WALLET_KEY_PATH=./wallet.key
# Live-only: derive budgets automatically as % of real total equity.
WALLET_AUTO_SIZE=true
# % of equity per book (used only when WALLET_AUTO_SIZE=true).
GRID_ALLOC_PCT=30
DCA_ALLOC_PCT=50
CYB_ALLOC_PCT=10
WALLET_RESERVE_PCT=10
# Re-derive budgets from real balances on this cadence (minutes), auto-sweeping
# profits/deposits without a restart. Live-only.
WALLET_RECHECK_MIN=30
# Re-sizing only fires when total equity moved more than this fraction since the
# last applied sizing (0.1 = 10%). Keeps ordinary SOL price wobble from churning
# the grid ladder; a real deposit/withdrawal/PnL swing crosses the threshold.
WALLET_RESIZE_HYSTERESIS_PCT=0.05

# Min interval (minutes) between DCA take-profit slice sells. Prevents rapid
# re-drain when price oscillates around the trail-back level right after a sell.
DCA_TP_COOLDOWN_MIN=30

# Minimum USDC kept out of all strategy books by the wallet sizer (idle buffer
# floor; the % reserve above is the main lever). Used by src/sizer.ts.
USDC_MIN_RESERVE=30

# Set to 1 to run the optional live on-chain transaction smoke tests
# (test/live.test.ts round-trips against real Jupiter). Unset = skipped.
#RUN_LIVE_TX_TESTS=1
