{
  "name": "grid-lord",
  "version": "0.1.0",
  "private": true,
  "description": "Local Solana SOL/USDC grid + DCA trading bot with paper-trading engine and dashboard",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-detect-module dist/bot.js",
    "dev": "tsx --experimental-detect-module watch src/bot.ts",
    "paper": "tsx --experimental-detect-module src/bot.ts",
    "quote": "tsx src/quote-test.ts",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:live": "node scripts/run-tests.mjs --live"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.0",
    "@pump-fun/pump-swap-sdk": "^1.19.0",
    "@solana/web3.js": "^1.95.0",
    "@types/bs58": "^4.0.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
